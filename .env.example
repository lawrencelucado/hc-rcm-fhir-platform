# Copy to .env and change every value:  cp .env.example .env
# .env is git-ignored. Never commit real credentials.

# PostgreSQL (warehouse)
POSTGRES_USER=rcm
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=rcm

# MinIO (S3-compatible raw landing zone)
MINIO_ROOT_USER=rcmadmin
MINIO_ROOT_PASSWORD=change-me-minio

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana
GRAFANA_ROOT_URL=http://localhost:3000

# Splunk (PHI audit SIEM)
SPLUNK_PASSWORD=Change-Me-Splunk1!
SPLUNK_HEC_TOKEN=change-me-hec-token
# Local Splunk uses a self-signed certificate. Set to true with a real certificate.
SPLUNK_VERIFY_TLS=false

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_SECRET_KEY=change-me-airflow-secret
